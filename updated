      text-decoration: none;
      color: inherit;
    }

    header {
      background-color: #000;
      padding: 20px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 {
      font-size: 1.8rem;
      color: #B20710;
      font-weight: 700;
      letter-spacing: 1px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 30px;
    }

    nav ul li a {
      color: #fff;
      font-weight: 500;
      transition: color 0.3s ease, transform 0.2s ease;
    }

    nav ul li a:hover {
      color: #B20710;
      transform: translateY(-2px);
    }

    .home {
      background: url('https://images.unsplash.com/photo-1517964603305-11c74e50b6d8?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
