        text-align: center;
      }

      .home h2 {
        font-size: 2.2rem;
      }

      header {
        padding: 15px 30px;
      }

      .class-cards, .plan-cards {
        flex-direction: column;
        gap: 20px;
      }
    }
  </style>
</head>

