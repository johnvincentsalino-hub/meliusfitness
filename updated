      justify-content: center;
      gap: 30px;
    }

    .class-item {
      background-color: #222;
      padding: 30px 20px;
      border-radius: 10px;
      width: 280px;
      transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .class-item:hover {
      background-color: #333;
      transform: translateY(-8px);
    }

    .class-item h4 {
      font-size: 1.3rem;
      margin-bottom: 10px;
      color: #fff;
    }

    .class-item p {
      color: #aaa;
      margin-bottom: 15px;
    }

    .class-item .btn-small {
      background-color: #B20710;
      color: #fff;
      padding: 10px 0;
      border: none;
