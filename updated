      color: #fff;
      padding: 14px 32px;
      border: none;
      border-radius: 4px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.2s ease;
    }

    .home .btn:hover {
      background-color: #ff3333;
      transform: translateY(-3px);
    }

    .about {
      display: flex;
      flex-wrap: wrap;
      padding: 80px 60px;
      align-items: center;
      background-color: #111;
      gap: 40px;
    }

    .about img {
      flex: 1 1 400px;
      max-width: 500px;
      border-radius: 10px;
    }

    .about-text {
      flex: 1 1 400px;
    }

    .about-text h3 {
      font-size: 2rem;
      color: #B20710;
